
"questions:address": [
  {
    "key": "address",
    "fieldGroup": [
      "{$if: store.enterManaully !== true}",
      "{$if: store.enterEirCode !== true}",
      {
        "key": "lookup",
        "type": "address-lookup",
        "resetOnHide": true,
        "templateOptions": {
          "endpoints": {
            "autocomplete": "@@nginxPrefix/geo/autocomplete",
            "findaddress": "@@nginxPrefix/ie/geo/address"
          },
          "additionalHeaders": {
            "x-api-key": "@@xApiKey"
          },
          "placeholder": "{$intl: ADDRESS-LOOKUP.INPUTS.ADDRESS.PLACEHOLDER}",
          "required": true,
          "noFloatingLabel": true,
          "hideRequiredMarker": true,
          "addressLookupIcon": "@@apiGatewayUrl/@@product/@@client/assets/images/icons/liberty-icons-address.svg",
          "noResultsMessage": ["{$intl: ADDRESS-LOOKUP.TEXT.NO-RESULTS}"],
          "tooManyResultsMessage": ["{$intl: ADDRESS-LOOKUP.TEXT.TOO-MANY-RESULTS}"],
          "serviceNotRespondingMessage": [
            "{$intl: ADDRESS-LOOKUP.TEXT.ADDRESS-SERVICE-NOT-RESPONDING}",
            {
              "type": "external-link",
              "href": "tel:+35315534040",
              "className": "text-nowrap",
              "content": "01 553 4040"
            }
          ]
        },
        "validation": {
          "messages": {
            "required": "{$intl: ADDRESS-LOOKUP.VALIDATION.REQUIRED-ADDRESS}",
            "invalidAddress": [
              {
                "type": "paragraph",
                "className": "mb-0",
                "content": [
                  {
                    "type": "text",
                    "content": "{$intl: ADDRESS-LOOKUP.VALIDATION.NOT-FOUND-ADDRESS}"
                  },
                  {
                    "type": "text",
                    "content": "{$intl: ADDRESS-LOOKUP.VALIDATION.NOT-FOUND-ADDRESS-AFTER-TEXT}"
                  }
                ]
              }
            ]
          }
        },
        "validators": {
          "validation": ["valid-address"]
        },
        "expressionProperties": {
          "templateOptions.tooManyResultsMessage.1": "' (' + field.templateOptions.foundTooManyResultsNumber + ') '"
        }
      },

      "{$if: store.enterManaully === true}",
      {
        "key": "manual",
        "wrappers": ["address-lookup"],
        "resetOnHide": true,
        "fieldGroup": [
          {
            "key": "addressLine1",
            "type": "input",
            "templateOptions": {
              "label": "{$intl: MANUAL-ADDRESS.INPUTS.ADDRESS-LINE-1.PLACEHOLDER}",
              "required": true,
              "hideRequiredMarker": true,
              "maxLength": 100
            },
            "validators": {
              "validation": ["no-whitespace-required", "max-length"]
            },
            "validation": {
              "messages": {
                "required": "{$intl: MANUAL-ADDRESS.VALIDATION.REQUIRED-ADDRESS-LINE-1}",
                "maxlength": "{$intl: MANUAL-ADDRESS.VALIDATION.LENGTH-ADDRESS-LINE-1}"
              }
            }
          },
          {
            "key": "addressLine2",
            "type": "input",
            "templateOptions": {
              "label": "{$intl: MANUAL-ADDRESS.INPUTS.ADDRESS-LINE-2.PLACEHOLDER}",
              "maxLength": 100
            },
            "validators": {
              "validation": ["max-length"]
            },
            "validation": {
              "messages": {
                "maxlength": "{$intl: MANUAL-ADDRESS.VALIDATION.LENGTH-ADDRESS-LINE-2}"
              }
            }
          },
          {
            "key": "city",
            "type": "input",
            "templateOptions": {
              "label": "{$intl: MANUAL-ADDRESS.INPUTS.CITY.PLACEHOLDER}",
              "required": true,
              "hideRequiredMarker": true,
              "maxLength": 76
            },
            "validators": {
              "validation": ["no-whitespace-required", "max-length"]
            },
            "validation": {
              "messages": {
                "required": "{$intl: MANUAL-ADDRESS.VALIDATION.REQUIRED-CITY}",
                "maxlength": "{$intl: MANUAL-ADDRESS.VALIDATION.LENGTH-CITY}"
              }
            }
          },
          {
            "key": "countyCode",
            "type": "select",
            "templateOptions": {
              "label": "{$intl: MANUAL-ADDRESS.INPUTS.COUNTY.PLACEHOLDER}",
              "required": true,
              "hideRequiredMarker": true,
              "options": []
            },
            "validation": {
              "messages": {
                "required": "{$intl: MANUAL-ADDRESS.VALIDATION.REQUIRED-COUNTY}"
              }
            }
          },
          {
            "key": "eircode",
            "type": "input",
            "templateOptions": {
              "label": "{$intl: MANUAL-ADDRESS.INPUTS.EIRCODE.PLACEHOLDER}",
              "pattern": "(?:^[AC-FHKNPRTV-Yac-fhknprtv-y][0-9]{2}|[Dd]6[Ww])[ -]?[0-9AC-FHKNPRTV-Yac-fhknprtv-y]{4}$"
            },
            "validation": {
              "messages": {
                "pattern": "{$intl: MANUAL-ADDRESS.VALIDATION.PATTERN-EIRCODE}"
              }
            }
          }
        ]
      },

      "{$if: store.enterEirCode === true}",
      {
        "key": "eircodeOnly",
        "type": "address-lookup",
        "resetOnHide": true,
        "templateOptions": {
          "endpoints": {
            "autocomplete": "@@nginxPrefix/geo/autocomplete",
            "findaddress": "@@nginxPrefix/ie/geo/address"
          },
          "additionalHeaders": {
            "x-api-key": "@@xApiKey"
          },
          "placeholder": "{$intl: ADDRESS-LOOKUP.INPUTS.ADDRESS.PLACEHOLDER}",
          "required": true,
          "noFloatingLabel": true,
          "hideRequiredMarker": true,
          "addressLookupIcon": "@@apiGatewayUrl/@@product/@@client/assets/images/icons/liberty-icons-address.svg",
          "noResultsMessage": ["{$intl: ADDRESS-LOOKUP.TEXT.NO-RESULTS}"],
          "tooManyResultsMessage": ["{$intl: ADDRESS-LOOKUP.TEXT.TOO-MANY-RESULTS}"],
          "serviceNotRespondingMessage": [
            "{$intl: ADDRESS-LOOKUP.TEXT.ADDRESS-SERVICE-NOT-RESPONDING}",
            {
              "type": "external-link",
              "href": "tel:+35315534040",
              "className": "text-nowrap",
              "content": "01 553 4040"
            }
          ]
        },
        "validation": {
          "messages": {
            "required": "{$intl: ADDRESS-LOOKUP.VALIDATION.REQUIRED-ADDRESS}"
          }
        },
        "validators": {
          "validation": ["valid-address"]
        }
      },

      {
        "key": "samePostalAddress",
        "type": "select-buttons-attached",
        "templateOptions": {
          "label": "{$intl: ADDRESS-LOOKUP.TEXT.HAS-SAME-POSTAL-ADDRESS}",
          "hideRequiredMarker": true,
          "alignCenter": true,
          "required": true,
          "options": [
            {
              "label": "{$intl: ADDRESS-LOOKUP.BUTTONS.YES}",
              "value": true
            },
            {
              "label": "{$intl: ADDRESS-LOOKUP.BUTTONS.NO}",
              "value": false
            }
          ]
        },
        "validation": {
          "messages": {
            "required": "{$intl: ADDRESS-LOOKUP.VALIDATION.REQUIRED-POSTAL-ADDRESS-ANS}"
          }
        }
      },

      "{$if: store.enterManaully !== true}",
      "{$if: store.enterEirCode !== true}",
      {
        "content": [
          {
            "type": "div",
            "className": "mb-0 mt-2 information-text",
            "content": [
              {
                "type": "text",
                "content": "{$intl: ADDRESS-LOOKUP.TEXT.ENTER-ADDRESS-MANUALLY-PRE-TEXT}"
              },
              {
                "className": "underline",
                "type": "page-event-button",
                "event": "ManualEntryA",
                "content": [
                  "{$intl: ADDRESS-LOOKUP.TEXT.ENTER-ADDRESS-MANUALLY-TEXT}",
                  {
                    "type": "image",
                    "className": "icon-image-sm lm-info-color-filter ml-1",
                    "src": "@@apiGatewayUrl/@@product/@@client/assets/images/icons/arrow-circle-right-light.svg"
                  }
                ]
              }
            ]
          }
        ]
      },

      "{$if: store.enterManaully === true}",
      "{$if: store.enterEirCode === false}",
      {
        "content": [
          {
            "type": "div",
            "className": "mb-0 mt-2 information-text",
            "content": [
              {
                "type": "text",
                "content": "{$intl: ADDRESS-LOOKUP.TEXT.ENTER-EIRCODE-MANUALLY-PRE-TEXT}"
              },
              {
                "className": "data-notice-confirmation",
                "type": "page-event-button",
                "event": "ManualEirCode",
                "content": [
                  "{$intl: ADDRESS-LOOKUP.TEXT.ENTER-EIRCODE-MANUALLY-TEXT}",
                  {
                    "type": "image",
                    "className": "icon-image-sm lm-info-color-filter ml-1",
                    "src": "@@apiGatewayUrl/@@product/@@client/assets/images/icons/arrow-circle-right-light.svg"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "@submit"
  }
]
