import {
  Component,
  EventEmitter,
  Input,
  OnInit,
  Output,
  TemplateRef,
  ViewChild,
} from '@angular/core';
import { FormControl } from '@angular/forms';
import { NgbTypeahead, NgbTypeaheadSelectItemEvent } from '@ng-bootstrap/ng-bootstrap';
import {
  BehaviorSubject,
  combineLatest,
  ConnectableObservable,
  EMPTY,
  merge,
  Observable,
  of,
} from 'rxjs';
import { catchError, debounceTime, filter, map, publish, switchMap, tap } from 'rxjs/operators';

import { Address, AddressOption, FindAddressResponse } from './address-interfaces';
import { AutoAddressService } from './autoaddress.service';

export interface AddressEvent {
  displayName: string;
  state: string;
}

export interface TooManyResultsEvent extends AddressEvent {
  resultNumber: number;
}

@Component({
  selector: 'gde-address-lookup',
  templateUrl: './address-lookup.component.html',
})
export class AddressLookupComponent implements OnInit {
  @ViewChild(NgbTypeahead, { static: true })
  public typeahead: NgbTypeahead;

  /** Form control passed in from Formly / parent form */
  @Input()
  public formControl: FormControl | null = null;

  @Input()
  public endpoints: any;

  @Input()
  public additionalHeaders: any;

  @Input()
  public placeholder: string;

  @Input()
  public noResultsTemplateRef: TemplateRef<any>;

  @Input()
  public tooManyResultsTemplateRef: TemplateRef<any>;

  @Input()
  public serviceNotRespondingTemplateRef: TemplateRef<any>;

  /** Emits when an address has been resolved */
  @Output()
  public valueChange: EventEmitter<Address> = new EventEmitter<Address>();

  @Output()
  public blur: EventEmitter<string> = new EventEmitter<string>();

  @Output()
  public focus: EventEmitter<Event> = new EventEmitter<Event>();

  @Output('status')
  public status$ = new BehaviorSubject<AddressEvent | TooManyResultsEvent | false>(false);

  public loading = false;
  public options: AddressOption[] = [];
  public addressOptionSelected$: EventEmitter<NgbTypeaheadSelectItemEvent> =
    new EventEmitter<NgbTypeaheadSelectItemEvent>();
  public isDisabled = false;

  private finalSelectedAddress: Address = null;

  @Input()
  set value(value: Address) {
    this.finalSelectedAddress = value;
    this.valueChange.emit(value);

    // keep external FormControl in sync when provided
    if (this.formControl) {
      this.formControl.setValue(value);
      this.formControl.markAsDirty();
      this.formControl.markAsTouched();
    }
  }

  get value(): Address {
    return this.finalSelectedAddress;
  }

  constructor(private autoAddressService: AutoAddressService) {}

  ngOnInit(): void {
    this.autoAddressService.endpoints = this.endpoints;
    this.autoAddressService.additionalHeaders = this.additionalHeaders;
    if (this.formControl && this.formControl.disabled) {
      this.isDisabled = true;
    }
  }

  formatter = (address: AddressOption) => address.displayName;

  getOptions = (
    addressPartial$: Observable<string>
  ): Observable<Array<AddressOption | AddressEvent>> => {
    const autoCompleteOptions$ = combineLatest([this.focus, addressPartial$]).pipe(
      map(([, addressPartial]) => addressPartial),
      debounceTime(500),
      // Reset status
      tap(() => this.status$.next(false)),
      tap(() => (this.loading = true)),
      switchMap((addressPartial: string) => this.autoCompleteAddress(addressPartial))
    );

    const findAddressOptions$ = this.addressOptionSelected$.pipe(
      tap(() => (this.loading = true)),
      switchMap((event: NgbTypeaheadSelectItemEvent) => this.addressSelected(event))
    );

    const options$ = merge(autoCompleteOptions$, findAddressOptions$).pipe(
      tap(() => (this.loading = false)),
      catchError(() => {
        this.setStatus({
          state: 'ServiceNotResponding',
          displayName: 'Sorry service is not responding',
        });

        return EMPTY;
      }),
      publish()
    );

    // Necessary to avoid problems with hot observable streams
    (options$ as ConnectableObservable<Array<AddressOption>>).connect();

    return options$;
  };

  addressSelected(event: NgbTypeaheadSelectItemEvent): Observable<Array<AddressOption>> {
    if (event.item.error) {
      event.preventDefault();
    }

    return this.autoAddressService.findPartialAddress(event.item).pipe(
      map((response: FindAddressResponse) => {
        const {
          matchLevel: { code },
          gdeAddress,
        } = response;

        this.value = { matchLevel: code, ...gdeAddress };

        if (response.totalOptions > response.options.length) {
          this.setStatus({
            state: 'TooManyResults',
            displayName: this.buildNumberOfResponsesMessage(response),
            resultNumber: response.totalOptions,
          });
        } else {
          event.preventDefault();
          return response.options || [];
        }
      }),
      filter((options) => options !== undefined && options !== null)
    );
  }

  autoCompleteAddress(addressPartial: string): Observable<Array<AddressOption>> {
    if (addressPartial === '') {
      return of([]);
    }

    return this.autoAddressService.autoCompleteAddress(addressPartial).pipe(
      map((response: FindAddressResponse): Array<AddressOption> => {
        if (response.totalOptions === 0) {
          this.setStatus({
            state: 'NoResults',
            displayName: 'No results',
          });
        } else if (response.totalOptions > response.options.length) {
          this.setStatus({
            state: 'TooManyResults',
            displayName: this.buildNumberOfResponsesMessage(response),
            resultNumber: response.totalOptions,
          });
        } else {
          return response.options || [];
        }
      }),
      filter((options) => options !== undefined && options !== null)
    );
  }

  setStatus(event: AddressEvent | TooManyResultsEvent) {
    this.loading = false;
    this.status$.next(event);
    this.typeahead.dismissPopup();
  }

  /** Consumer can call this to enable/disable explicitly if needed */
  @Input()
  set disabled(isDisabled: boolean) {
    this.isDisabled = isDisabled;
    if (this.formControl) {
      if (isDisabled) {
        this.formControl.disable({ emitEvent: false });
      } else {
        this.formControl.enable({ emitEvent: false });
      }
    }
  }

  private buildNumberOfResponsesMessage(response: FindAddressResponse): string {
    const maxNumberToShow = 2 ** 31 - 1;

    return (
      'We found too many results.' +
      (response.totalOptions === maxNumberToShow ? '' : ` (${response.totalOptions})`)
    );
  }
}
