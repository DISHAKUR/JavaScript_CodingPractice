<ng-template #defaultEventTemplateRef let-displayName="displayName">
  {{ displayName }}
</ng-template>

<gde-typeahead-spinner [loading]="loading">
  <input
    type="text"
    class="form-control"
    [attr.placeholder]="placeholder"
    [ngbTypeahead]="getOptions"
    [resultFormatter]="formatter"
    [inputFormatter]="formatter"
    (selectItem)="addressOptionSelected$.emit($event)"
    (blur)="blur.emit()"
    (focus)="focus.emit($event)"
    [disabled]="isDisabled"
  />

  <div class="dropdown-menu p-4 show" *ngIf="status$ | async as status">
    <div>
      <ng-container [ngSwitch]="status.state">
        <ng-container *ngSwitchCase="'TooManyResults'">
          <ng-container
            *ngTemplateOutlet="
              tooManyResultsTemplateRef || defaultEventTemplateRef;
              context: status
            "
          >
          </ng-container>
        </ng-container>
        <ng-container *ngSwitchCase="'NoResults'">
          <ng-container
            *ngTemplateOutlet="noResultsTemplateRef || defaultEventTemplateRef; context: status"
          >
          </ng-container>
        </ng-container>
        <ng-container *ngSwitchCase="'ServiceNotResponding'">
          <ng-container
            *ngTemplateOutlet="
              serviceNotRespondingTemplateRef || defaultEventTemplateRef;
              context: status
            "
          >
          </ng-container>
        </ng-container>
      </ng-container>
    </div>
  </div>
</gde-typeahead-spinner>
